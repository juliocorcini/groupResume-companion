{
  "name": "groupresume-companion",
  "version": "1.0.0",
  "description": "WhatsApp group summarizer companion — live connection, auto-summaries, and bot commands",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "tray": "powershell -ExecutionPolicy Bypass -File scripts/tray.ps1",
    "tray:hidden": "wscript scripts\\tray-launcher.vbs",
    "setup": "powershell -ExecutionPolicy Bypass -File scripts/setup-windows.ps1",
    "setup:uninstall": "powershell -ExecutionPolicy Bypass -File scripts/setup-windows.ps1 -Uninstall"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.22.1",
    "groq-sdk": "^0.5.0",
    "open": "^10.1.0",
    "qrcode": "^1.5.4",
    "whatsapp-web.js": "^1.34.7",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.0",
    "@types/qrcode": "^1.5.5",
    "@types/ws": "^8.5.10",
    "tsx": "^4.19.0",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "allowScripts": {
    "puppeteer@24.38.0": true,
    "esbuild@0.28.2": true
  }
}
